{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".github/**",
      ".firebase/**",
      ".vscode/**",
      ".idea/**",
      "**/node_modules/**",
      "functions/**",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "database.rules.json",
      "remoteconfig.template.json",
      "package.json",
      "package-lock.json",
      "**/*.md",
      "worker.js"
    ]
  },
  "functions": { "source": "functions", "runtime": "nodejs18" },
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" }
}
